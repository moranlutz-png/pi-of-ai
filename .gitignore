# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- Virtual envs / build dirs living outside the tree ----
# (the GPU/CPU torch venvs are multi-GB — never commit them)
rb/
rbgpu/

# ---- Large model & data binaries (regenerable; host on Hugging Face) ----
*.gguf
*.pt
*.bin
*.safetensors
*.onnx
*.ckpt

# Generated corpora / checkpoints
scratch_coder/data/
scratch_coder/data_big/
rules_baker/outputs/

# Per-checkpoint inspector export (regenerate with scratch_coder/export_inspect.py);
# arch.json is committed as the no-checkpoint structural fallback.
scratch_coder/web/inspect.json
scratch_coder/web/probe.json
# The decoded training corpus (~1.8 MB) shown by the training-data view — regenerable.
scratch_coder/web/corpus.txt
# The rules_baker app embeds a same-origin copy of the inspector; its generated
# data is mirrored there and is likewise regenerable, not source.
rules_baker/web/scratch/inspect.json
rules_baker/web/scratch/corpus.txt
# weights.bin (the attention rung's sidecar) is caught by the *.bin rule above.

# ---- Generated dataset (regenerate with data_gen/generate_dataset.py) ----
rules_baker/datasets/*.jsonl
rules_baker/datasets/*.progress.txt

# ---- Seeds ingested from someone's own documents (documents_to_seeds.py) ----
# Output, not source, and it can carry text from private documents — which is a
# second reason not to commit it by accident.
rules_baker/data_gen/seeds/from_documents.txt
rules_baker/data_gen/seeds/from_documents.ingestsheet.json

# ---- Caches ----
.cache/
hf_cache/
*.log

# ---- OS cruft ----
Thumbs.db
.DS_Store
